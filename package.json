{
  "name": "hypermemory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test --coverage",
    "check": "bun run src/cli.ts memory",
    "migrate": "bun run src/migrate.ts",
    "upgrade": "bun run src/upgrade.ts",
    "lint": "biome ci .",
    "typecheck": "tsc --noEmit -p .",
    "size": "bun run scripts/check-size.ts",
    "gate": "bun run lint && bun run typecheck && bun run size && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "^1.4.4",
    "fast-check": "4",
    "typescript": "^7.0.2"
  }
}
